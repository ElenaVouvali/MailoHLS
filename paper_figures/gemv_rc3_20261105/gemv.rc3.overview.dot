digraph gemv {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.25", ranksep="0.6", fontname="Helvetica", labelloc=t, label="GEMV 32 × 32 | structural V2.2 RC3 | operation overview"];
