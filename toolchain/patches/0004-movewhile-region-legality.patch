From d966cdf3ee9ca72120301acac54a2101c3b44693 Mon Sep 17 00:00:00 2001
From: Your Name <your.email@example.com>
Date: Sun, 19 Jul 2026 12:29:35 +0300
Subject: [PATCH] polygeist: guard while-to-for conversion for region-local
 values

---
 lib/polygeist/Passes/CanonicalizeFor.cpp      | 56 +++++++++++++++++++
 .../movewhile-region-legality.mlir            | 53 ++++++++++++++++++
 2 files changed, 109 insertions(+)
 create mode 100644 test/polygeist-opt/movewhile-region-legality.mlir

diff --git a/lib/polygeist/Passes/CanonicalizeFor.cpp b/lib/polygeist/Passes/CanonicalizeFor.cpp
index d04487d4689f..d49fa819442d 100644
--- a/lib/polygeist/Passes/CanonicalizeFor.cpp
+++ b/lib/polygeist/Passes/CanonicalizeFor.cpp
@@ -906,6 +906,62 @@ struct MoveWhileToFor : public OpRewritePattern<WhileOp> {
     }
     if (!helper.computeLegality(/*sizeCheck*/ true))
       return failure();
+
+    DominanceInfo dominance(loop->getParentOp());
+    auto isWhileRegionArgument = [&](Value value) {
+      auto argument = dyn_cast<BlockArgument>(value);
+      if (!argument)
+        return false;
+      Region *region = argument.getParentRegion();
+      return region == &loop.getBefore() || region == &loop.getAfter();
+    };
+    auto isLegalExternalValue = [&](Value value) {
+      if (!value || isWhileRegionArgument(value))
+        return false;
+      if (Operation *definingOp = value.getDefiningOp())
+        if (loop->isAncestor(definingOp))
+          return false;
+      return dominance.properlyDominates(value, loop);
+    };
+
+    // Compute every value that will be used outside the while before changing
+    // either region.  In particular, condition arguments may be defined in the
+    // before region and therefore cannot be used as scf.for initializers.
+    SmallVector<Value, 8> proposedForArgs(loop.getInits().begin(),
+                                          loop.getInits().end());
+    for (Value arg : condOp.getArgs()) {
+      if (auto cast = arg.getDefiningOp<IndexCastOp>())
+        arg = cast.getIn();
+      if (isTopLevelArgValue(arg, &loop.getBefore())) {
+        auto blockArg = cast<BlockArgument>(arg);
+        arg = loop.getInits()[blockArg.getArgNumber()];
+      }
+      proposedForArgs.push_back(arg);
+    }
+
+    for (Value value : proposedForArgs)
+      if (!isLegalExternalValue(value))
+        return rewriter.notifyMatchFailure(
+            loop, "scf.for initializer does not dominate the while");
+    for (Value value : {helper.lb, helper.ub, helper.step})
+      if (!isLegalExternalValue(value))
+        return rewriter.notifyMatchFailure(
+            loop, "scf.for bound or step does not dominate the while");
+
+    if (condOp.getArgs().size() != loop.getNumResults())
+      return rewriter.notifyMatchFailure(
+          loop, "condition values do not correspond to while results");
+    for (auto [result, forwarded] :
+         llvm::zip(loop.getResults(), condOp.getArgs())) {
+      if (result.getType() != forwarded.getType())
+        return rewriter.notifyMatchFailure(
+            loop, "condition value type does not match while result");
+      for (OpOperand &use : result.getUses())
+        if (!dominance.properlyDominates(loop, use.getOwner()))
+          return rewriter.notifyMatchFailure(
+              loop, "replacement cannot dominate a while result user");
+    }
+
     helper.prepareFor(rewriter);
 
     // input of the for goes the input of the scf::while plus the output taken
diff --git a/test/polygeist-opt/movewhile-region-legality.mlir b/test/polygeist-opt/movewhile-region-legality.mlir
new file mode 100644
index 000000000000..a07b09656884
--- /dev/null
+++ b/test/polygeist-opt/movewhile-region-legality.mlir
@@ -0,0 +1,53 @@
+// RUN: polygeist-opt --canonicalize-scf-for %s | FileCheck %s
+
+module {
+  func.func @unsafe_region_local(%upper: i64) -> (i32, i64, i32) {
+    %c0 = arith.constant 0 : i32
+    %c1 = arith.constant 1 : i32
+    %loop:3 = scf.while (%iv = %c0, %acc = %c0) : (i32, i32) -> (i32, i64, i32) {
+      %wide = arith.extsi %iv : i32 to i64
+      %continue = arith.cmpi slt, %wide, %upper : i64
+      scf.condition(%continue) %acc, %wide, %iv : i32, i64, i32
+    } do {
+    ^bb0(%out_acc: i32, %out_wide: i64, %out_iv: i32):
+      %next_iv = arith.addi %out_iv, %c1 : i32
+      %next_acc = arith.addi %out_acc, %c1 : i32
+      scf.yield %next_iv, %next_acc : i32, i32
+    }
+    return %loop#0, %loop#1, %loop#2 : i32, i64, i32
+  }
+
+  func.func @safe_conversion(%output: memref<?xi32>, %upper: i32) -> (i32, i32) {
+    %c0 = arith.constant 0 : i32
+    %c1 = arith.constant 1 : i32
+    %c2 = arith.constant 2 : i32
+    %loop:2 = scf.while (%iv = %c0, %acc = %c0) : (i32, i32) -> (i32, i32) {
+      %continue = arith.cmpi slt, %iv, %upper : i32
+      scf.condition(%continue) %iv, %acc : i32, i32
+    } do {
+    ^bb0(%out_iv: i32, %out_acc: i32):
+      %index = arith.index_cast %out_iv : i32 to index
+      memref.store %out_acc, %output[%index] : memref<?xi32>
+      %next_iv = arith.addi %out_iv, %c1 : i32
+      %next_acc = arith.addi %out_acc, %c2 : i32
+      scf.yield %next_iv, %next_acc : i32, i32
+    }
+    return %loop#0, %loop#1 : i32, i32
+  }
+}
+
+// CHECK-LABEL: func.func @unsafe_region_local
+// CHECK: %[[LOOP:.+]]:3 = scf.while
+// CHECK: %[[WIDE:.+]] = arith.extsi
+// CHECK: scf.condition({{.*}}) {{.*}}, %[[WIDE]], {{.*}} : i32, i64, i32
+// CHECK: return %[[LOOP]]#0, %[[LOOP]]#1, %[[LOOP]]#2 : i32, i64, i32
+
+// CHECK-LABEL: func.func @safe_conversion
+// CHECK-NOT: scf.while
+// CHECK: %[[UPPER_INDEX:.+]] = arith.index_cast {{.*}} : i32 to index
+// CHECK: %[[FINAL_IV:.+]] = arith.index_cast %[[UPPER_INDEX]] : index to i32
+// CHECK: %[[DOUBLE:.+]] = arith.muli %[[UPPER_INDEX]], {{.*}} : index
+// CHECK: %[[FINAL_ACC:.+]] = arith.index_cast %[[DOUBLE]] : index to i32
+// CHECK: scf.for
+// CHECK: memref.store
+// CHECK: return %[[FINAL_IV]], %[[FINAL_ACC]] : i32, i32
