--- /dev/null
+++ b/tools/cgeist/Test/Verification/mem2reg-type-punned-load.cpp
@@ -0,0 +1,17 @@
+// RUN: cgeist %s --function='*' -S -O3 | polygeist-opt --verify-each
+
+#include <stdint.h>
+
+float type_punned_load(bool select_float) {
+  uint32_t storage = 0x3f800000u;
+  if (select_float)
+    return *reinterpret_cast<float *>(&storage);
+  return 0.0f;
+}
+
+uint32_t same_type_forward(bool overwrite) {
+  uint32_t storage = 1;
+  if (overwrite)
+    storage = 2;
+  return storage;
+}

