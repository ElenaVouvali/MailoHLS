diff --git a/unittests/LLVMAsMemRefElementTest.cpp b/unittests/LLVMAsMemRefElementTest.cpp
new file mode 100644
index 000000000000..b506502503d8
--- /dev/null
+++ b/unittests/LLVMAsMemRefElementTest.cpp
@@ -0,0 +1,50 @@
+#include "polygeist/Support/LLVMAsMemRefElement.h"
+
+#include "mlir/Dialect/LLVMIR/LLVMDialect.h"
+#include "mlir/IR/BuiltinTypes.h"
+#include "mlir/IR/Verifier.h"
+#include "gtest/gtest.h"
+
+using namespace mlir;
+
+TEST(LLVMAsMemRefElementTest, RegistersOnlySupportedLLVMTypes) {
+  MLIRContext context;
+  context.getOrLoadDialect<LLVM::LLVMDialect>();
+
+  Type i32 = IntegerType::get(&context, 32);
+  Type structType = LLVM::LLVMStructType::getLiteral(&context, {i32});
+  Type arrayType = LLVM::LLVMArrayType::get(i32, 4);
+  Type pointerType = LLVM::LLVMPointerType::get(&context);
+  Type functionType = LLVM::LLVMFunctionType::get(i32, {}, false);
+  Type unsupportedType = TupleType::get(&context, {i32});
+
+  EXPECT_FALSE(BaseMemRefType::isValidElementType(structType));
+  polygeist::registerLLVMAsMemRefElementTypes(context);
+  EXPECT_TRUE(BaseMemRefType::isValidElementType(structType));
+  EXPECT_TRUE(BaseMemRefType::isValidElementType(arrayType));
+  EXPECT_TRUE(BaseMemRefType::isValidElementType(pointerType));
+  EXPECT_TRUE(BaseMemRefType::isValidElementType(functionType));
+  EXPECT_FALSE(BaseMemRefType::isValidElementType(unsupportedType));
+}
+
+TEST(LLVMAsMemRefElementTest, RegistersSharedLLVMPointerElementTypes) {
+  MLIRContext context;
+  context.getOrLoadDialect<LLVM::LLVMDialect>();
+  polygeist::registerPolygeistLLVMPointerElementTypes(context);
+
+  OpBuilder builder(&context);
+  auto module = ModuleOp::create(builder.getUnknownLoc());
+  auto pointer = LLVM::LLVMPointerType::get(&context);
+  auto functionType = LLVM::LLVMFunctionType::get(
+      LLVM::LLVMVoidType::get(&context), {pointer}, false);
+  auto function = builder.create<LLVM::LLVMFuncOp>(builder.getUnknownLoc(),
+                                                   "load_index", functionType);
+  Block *entry = function.addEntryBlock();
+  builder.setInsertionPointToStart(entry);
+  builder.create<LLVM::LoadOp>(builder.getUnknownLoc(), builder.getIndexType(),
+                               entry->getArgument(0));
+  builder.create<LLVM::ReturnOp>(builder.getUnknownLoc(), ValueRange{});
+  module.push_back(function);
+
+  EXPECT_TRUE(succeeded(verify(module)));
+}
