--- /dev/null
+++ b/python/PolygeistPythonExtension.cpp
@@ -0,0 +1,13 @@
+//===- PolygeistPythonExtension.cpp - Python context registration --------===//
+
+#include "polygeist-c/Registration.h"
+
+#include "mlir/Bindings/Python/PybindAdaptors.h"
+
+namespace py = pybind11;
+
+PYBIND11_MODULE(_site_initialize_0, module) {
+  module.def("context_init_hook", [](MlirContext context) {
+    mlirPolygeistInitializeContext(context);
+  });
+}
