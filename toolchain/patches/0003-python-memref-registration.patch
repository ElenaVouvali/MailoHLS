+//===- LLVMAsMemRefElement.h - LLVM types in memrefs ------------*- C++ -*-===//
+
+#ifndef POLYGEIST_SUPPORT_LLVMASMEMREFELEMENT_H
+#define POLYGEIST_SUPPORT_LLVMASMEMREFELEMENT_H
+
+namespace mlir {
+class MLIRContext;
+}
+
+namespace mlir::polygeist {
+
+/// Attach Polygeist's MemRefElementTypeInterface model to the LLVM dialect
+/// types accepted as memref elements by the cgeist lowering.
+void registerLLVMAsMemRefElementTypes(MLIRContext &context);
+
+/// Register the common LLVM pointer-element models used by Polygeist tools.
+void registerPolygeistLLVMPointerElementTypes(MLIRContext &context);
+
+} // namespace mlir::polygeist
+
+#endif // POLYGEIST_SUPPORT_LLVMASMEMREFELEMENT_H
