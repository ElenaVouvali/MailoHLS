+#!/usr/bin/env python3
+"""Regression tests for Polygeist's automatic Python context extension."""
+
+import os
+import subprocess
+import sys
+
+from mlir import ir
+
+
+SUPPORTED = """module {
+  memref.global @struct : memref<1x!llvm.struct<(i32)>>
+  memref.global @array : memref<1x!llvm.array<4 x i32>>
+  memref.global @pointer : memref<1x!llvm.ptr>
+  memref.global @function : memref<1x!llvm.func<void ()>>
+  llvm.func @load_index(%arg0: !llvm.ptr) {
+    %0 = llvm.load %arg0 : !llvm.ptr -> index
+    llvm.return
+  }
+}
+"""
+
+UNSUPPORTED = """module {
+  memref.global @unsupported : memref<1x!gpu.async.token>
+}
+"""
+
+UNSUPPORTED_BUILTIN = """module {
+  memref.global @unsupported : memref<1xtuple<i32>>
+}
+"""
+
+
+def parse_in_two_contexts():
+    printed = []
+    for _ in range(2):
+        with ir.Context() as context:
+            module = ir.Module.parse(SUPPORTED, context)
+            assert module.operation.verify()
+            printed.append(str(module))
+            for invalid_module in (UNSUPPORTED, UNSUPPORTED_BUILTIN):
+                try:
+                    ir.Module.parse(invalid_module, context)
+                except ir.MLIRError as error:
+                    assert "invalid memref element type" in str(error)
+                else:
+                    raise AssertionError("unsupported memref element was accepted")
+    assert printed[0] == printed[1]
+    return printed[0]
+
+
+if "--worker" in sys.argv:
+    print(parse_in_two_contexts(), end="")
+else:
+    outputs = []
+    for _ in range(2):
+        result = subprocess.run(
+            [sys.executable, "-S", __file__, "--worker"],
+            check=True,
+            capture_output=True,
+            text=True,
+            env=os.environ.copy(),
+        )
+        outputs.append(result.stdout)
+    assert outputs[0] == outputs[1]
+    print("Polygeist Python memref-element registration: PASS")
