+#include "polygeist-c/Registration.h"
+
+#include "polygeist/Dialect.h"
+#include "polygeist/Support/LLVMAsMemRefElement.h"
+
+#include "mlir/CAPI/IR.h"
+
+void mlirPolygeistRegisterLLVMAsMemRefElementTypes(MlirContext context) {
+  mlir::polygeist::registerLLVMAsMemRefElementTypes(*unwrap(context));
+}
+
+void mlirPolygeistInitializeContext(MlirContext context) {
+  mlir::MLIRContext *cppContext = unwrap(context);
+  cppContext->getOrLoadDialect<mlir::polygeist::PolygeistDialect>();
+  mlir::polygeist::registerLLVMAsMemRefElementTypes(*cppContext);
+  mlir::polygeist::registerPolygeistLLVMPointerElementTypes(*cppContext);
+}
