+//===- LLVMAsMemRefElement.cpp - LLVM types in memrefs --------------------===//
+
+#include "polygeist/Support/LLVMAsMemRefElement.h"
+
+#include "mlir/Dialect/LLVMIR/LLVMDialect.h"
+#include "mlir/IR/BuiltinTypeInterfaces.h"
+
+namespace mlir::polygeist {
+namespace {
+
+class LLVMAsMemRefElement
+    : public MemRefElementTypeInterface::FallbackModel<LLVMAsMemRefElement> {};
+
+template <typename T>
+struct PolygeistLLVMPointerElement
+    : public LLVM::PointerElementTypeInterface::ExternalModel<
+          PolygeistLLVMPointerElement<T>, T> {};
+
+} // namespace
+
+void registerLLVMAsMemRefElementTypes(MLIRContext &context) {
+  context.getOrLoadDialect<LLVM::LLVMDialect>();
+  LLVM::LLVMFunctionType::attachInterface<LLVMAsMemRefElement>(context);
+  LLVM::LLVMArrayType::attachInterface<LLVMAsMemRefElement>(context);
+  LLVM::LLVMPointerType::attachInterface<LLVMAsMemRefElement>(context);
+  LLVM::LLVMStructType::attachInterface<LLVMAsMemRefElement>(context);
+}
+
+void registerPolygeistLLVMPointerElementTypes(MLIRContext &context) {
+  context.getOrLoadDialect<LLVM::LLVMDialect>();
+  IndexType::attachInterface<PolygeistLLVMPointerElement<IndexType>>(context);
+  MemRefType::attachInterface<PolygeistLLVMPointerElement<MemRefType>>(context);
+  LLVM::LLVMStructType::attachInterface<
+      PolygeistLLVMPointerElement<LLVM::LLVMStructType>>(context);
+  LLVM::LLVMPointerType::attachInterface<
+      PolygeistLLVMPointerElement<LLVM::LLVMPointerType>>(context);
+  LLVM::LLVMArrayType::attachInterface<
+      PolygeistLLVMPointerElement<LLVM::LLVMArrayType>>(context);
+}
+
+} // namespace mlir::polygeist
