+include(AddMLIRPython)
+find_package(Python3 COMPONENTS Interpreter Development.Module REQUIRED)
+execute_process(
+  COMMAND "${Python3_EXECUTABLE}" -m pybind11 --cmakedir
+  OUTPUT_VARIABLE POLYGEIST_PYBIND11_CMAKE_DIR
+  OUTPUT_STRIP_TRAILING_WHITESPACE
+  COMMAND_ERROR_IS_FATAL ANY
+)
+find_package(pybind11 CONFIG REQUIRED
+  PATHS "${POLYGEIST_PYBIND11_CMAKE_DIR}"
+  NO_DEFAULT_PATH
+)
+
+declare_mlir_python_extension(PolygeistPythonExtension
+  MODULE_NAME _site_initialize_0
+  ROOT_DIR "${CMAKE_CURRENT_SOURCE_DIR}"
+  SOURCES
+    PolygeistPythonExtension.cpp
+)
+
+# Extend the matching Python CAPI DSO with Polygeist's registration entry point
+# and its shared implementation. This avoids linking a second MLIR runtime into
+# the native module and keeps every context/type object in one MLIR instance.
+target_sources(MLIRPythonCAPI PRIVATE
+  $<TARGET_OBJECTS:obj.MLIRPolygeistSupport>
+  $<TARGET_OBJECTS:obj.MLIRCAPIPolygeistRegistration>
+  $<TARGET_OBJECTS:obj.MLIRPolygeist>
+)
+add_dependencies(MLIRPythonCAPI
+  obj.MLIRPolygeistSupport
+  obj.MLIRCAPIPolygeistRegistration
+  obj.MLIRPolygeist
+)
+
+add_mlir_python_modules(PolygeistPythonModules
+  ROOT_PREFIX "${LLVM_BINARY_DIR}/tools/mlir/python_packages/mlir_core/mlir"
+  INSTALL_PREFIX "python_packages/mlir_core/mlir"
+  DECLARED_SOURCES
+    PolygeistPythonExtension
+  COMMON_CAPI_LINK_LIBS
+    MLIRPythonCAPI
+)
+add_dependencies(PolygeistPythonModules MLIRPythonModules)
+
+add_custom_target(check-polygeist-python
+  COMMAND "${CMAKE_COMMAND}" -E env
+    "PYTHONPATH=${LLVM_BINARY_DIR}/tools/mlir/python_packages/mlir_core"
+    "${Python3_EXECUTABLE}" -S
+    "${CMAKE_CURRENT_SOURCE_DIR}/test_registration.py"
+  DEPENDS PolygeistPythonModules
+  VERBATIM
+)
