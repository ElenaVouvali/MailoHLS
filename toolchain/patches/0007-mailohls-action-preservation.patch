+// RUN: split-file %s %t
+// RUN: cd %t && cgeist source.c --function=preserve_array -S -O0 -scal-rep=0 -memref-fullrank --raise-scf-to-affine --print-debug-info -mailohls-action-manifest=actions.tsv | FileCheck %s
+
+// CHECK: memref.alloca() {mailohls.action_id = "L1", mailohls.action_kind = "array"} : memref<100x4xf32> loc(#[[PROTECTED:loc[0-9]+]])
+// CHECK-NOT: memref.alloca
+// CHECK-NOT: scf.if
+// CHECK: affine.for
+// CHECK: affine.store {{.*}} loc(
+// CHECK-DAG: #[[PROTECTED]] = loc("{{.*}}source.c":2:9)
+
+//--- source.c
+void preserve_array(float input[800]) {
+  float protected_copy[100][4];
+  float ordinary_copy[100][4];
+  for (int box = 0; box < 2; ++box) {
+    for (int i = 0; i < 100; ++i)
+      for (int j = 0; j < 4; ++j)
+        protected_copy[i][j] = input[(box * 100 + i) * 4 + j];
+    for (int i = 0; i < 100; ++i)
+      for (int j = 0; j < 4; ++j)
+        ordinary_copy[i][j] = input[(box * 100 + i) * 4 + j];
+    for (int i = 0; i < 100; ++i)
+      for (int j = 0; j < 4; ++j)
+        protected_copy[i][j] += ordinary_copy[i][j];
+  }
+}
+
+//--- actions.tsv
+L1	array	source.c	2	9

