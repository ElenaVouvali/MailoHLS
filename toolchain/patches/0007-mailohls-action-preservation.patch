+namespace {
+struct MailoHLSArrayAction {
+  std::string id;
+  std::string filename;
+  unsigned line;
+  unsigned column;
+};
+
+class MarkMailoHLSArrayActionsPass
+    : public mlir::PassWrapper<MarkMailoHLSArrayActionsPass,
+                               mlir::OperationPass<mlir::func::FuncOp>> {
+public:
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(MarkMailoHLSArrayActionsPass)
+
+  explicit MarkMailoHLSArrayActionsPass(
+      std::shared_ptr<const std::vector<MailoHLSArrayAction>> actions)
+      : actions(std::move(actions)) {}
+
+  void runOnOperation() override {
+    getOperation()->walk([&](mlir::Operation *op) {
+      if (!llvm::isa<mlir::memref::AllocaOp>(op))
+        return;
+      auto loc = llvm::dyn_cast<mlir::FileLineColLoc>(op->getLoc());
+      if (!loc)
+        return;
+      for (const MailoHLSArrayAction &action : *actions) {
+        if (loc.getFilename() != action.filename ||
+            loc.getLine() != action.line || loc.getColumn() != action.column)
+          continue;
+        op->setAttr("mailohls.action_id",
+                    mlir::StringAttr::get(op->getContext(), action.id));
+        op->setAttr("mailohls.action_kind",
+                    mlir::StringAttr::get(op->getContext(), "array"));
+        break;
+      }
+    });
+  }
+
+private:
+  std::shared_ptr<const std::vector<MailoHLSArrayAction>> actions;
+};
+
+static std::shared_ptr<const std::vector<MailoHLSArrayAction>>
+loadMailoHLSArrayActions(llvm::StringRef path) {
+  auto buffer = llvm::MemoryBuffer::getFile(path);
+  if (!buffer) {
+    llvm::errs() << "error: cannot read MailoHLS action manifest '" << path
+                 << "': " << buffer.getError().message() << "\n";
+    return nullptr;
+  }
+
+  auto actions = std::make_shared<std::vector<MailoHLSArrayAction>>();
+  llvm::SmallVector<llvm::StringRef> lines;
+  buffer.get()->getBuffer().split(lines, '\n', -1, false);
+  for (auto indexedLine : llvm::enumerate(lines)) {
+    llvm::StringRef line = indexedLine.value();
+    if (line.empty())
+      continue;
+    llvm::SmallVector<llvm::StringRef> fields;
+    line.split(fields, '\t', -1, true);
+    if (fields.size() != 5 || fields[0].empty() || fields[2].empty()) {
+      llvm::errs() << "error: malformed MailoHLS action manifest line "
+                   << indexedLine.index() + 1 << "\n";
+      return nullptr;
+    }
+    if (fields[1] != "array")
+      continue;
+    unsigned sourceLine;
+    unsigned sourceColumn;
+    if (fields[3].getAsInteger(10, sourceLine) || sourceLine == 0 ||
+        fields[4].getAsInteger(10, sourceColumn) || sourceColumn == 0) {
+      llvm::errs() << "error: invalid MailoHLS source location on manifest "
+                      "line "
+                   << indexedLine.index() + 1 << "\n";
+      return nullptr;
+    }
+    actions->push_back({fields[0].str(), fields[2].str(), sourceLine,
+                        sourceColumn});
+  }
+  return actions;
+}
