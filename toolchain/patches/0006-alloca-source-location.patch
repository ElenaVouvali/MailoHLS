+// RUN: cgeist %s --function=alloca_locations -S -O0 -memref-fullrank --print-debug-info | FileCheck %s
+// RUN: cgeist %s --function=alloca_locations -S -O0 -memref-fullrank --print-debug-info | mlir-opt --verify-each
+
+#include "Inputs/alloca-location-type.h"
+
+extern void consume(header_element_t *);
+
+void alloca_locations(void) {
+  header_element_t first[8];
+  header_element_t second[8];
+  consume(first);
+  consume(second);
+}
+
+// CHECK: memref.alloca() : memref<8xf32> loc(#[[SECOND:loc[0-9]+]])
+// CHECK: memref.alloca() : memref<8xf32> loc(#[[FIRST:loc[0-9]+]])
+// CHECK-DAG: #[[FIRST]] = loc("{{.*}}alloca-location.c":9:20)
+// CHECK-DAG: #[[SECOND]] = loc("{{.*}}alloca-location.c":10:20)
